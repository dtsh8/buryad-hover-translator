{
  "manifest_version": 3,
  "name": "Buryad Hover Translator",
  "version": "1.0.0",
  "description": "Hover over a Buryad word or select a phrase to see its Russian translation in a tooltip. Dictionary-first (burlang.ru), cached, minimal Google Translate use.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://burlang.ru/*"],
  "optional_host_permissions": ["https://translate.googleapis.com/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options/options.html", "open_in_tab": false },
  "action": { "default_title": "Buryad Hover Translator (click to toggle)", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } }
}
